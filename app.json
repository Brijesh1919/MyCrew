{
  "expo": {
    "name": "MyCrew",
    "slug": "MyCrew",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "mycrew",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MyCrew uses your location while you're part of an active crew so your friends can find you."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MyCrew to access your camera to scan crew QR codes."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/analytics",
      "@react-native-firebase/crashlytics",
      "@react-native-firebase/perf"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mycrew.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "MyCrew uses your location while you're part of an active crew so your friends can find you.",
        "NSCameraUsageDescription": "Allow MyCrew to access your camera to scan crew QR codes."
      }
    },
    "android": {
      "package": "com.mycrew.app",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "CAMERA",
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F1F5F9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "daf61520-b582-4e3a-bee2-5d0cb933a028"
      }
    }
  }
}

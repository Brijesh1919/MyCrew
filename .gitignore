# ==========================================================
# MyCrew — Production .gitignore
# Expo SDK / React Native / Web / Supabase
# ==========================================================

# ----------------------------------------------------------
# Dependencies & Package Managers
# ----------------------------------------------------------
node_modules/
.pnp
.pnp.js

# ----------------------------------------------------------
# Expo, Metro & Web Builds
# ----------------------------------------------------------
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts
.metro-health-check*
*.jsbundle

# ----------------------------------------------------------
# Environment & Secret Configuration Files
# ----------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env.template

# ----------------------------------------------------------
# EAS & Mobile Credentials
# ----------------------------------------------------------
.eas/
credentials.json

# ----------------------------------------------------------
# Continuous Native Generation (CNG) & Native Build Artifacts
# Do not commit generated ios/ and android/ folders in Expo CNG
# ----------------------------------------------------------
/ios/
/android/
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision
AuthKey_*.p8

# Native App Binaries
*.apk
*.aab
*.ipa

# ----------------------------------------------------------
# Supabase CLI Local Artifacts
# ----------------------------------------------------------
.supabase/
supabase/.temp/

# ----------------------------------------------------------
# Logs, Diagnostic & Debug Dumps
# ----------------------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# ----------------------------------------------------------
# Cache & Build Tools
# ----------------------------------------------------------
.cache/
*.tsbuildinfo
.eslintcache
.parcel-cache/
.turbo/

# ----------------------------------------------------------
# Testing & Code Coverage
# ----------------------------------------------------------
coverage/
*.lcov
.nyc_output/

# ----------------------------------------------------------
# Operating System Files
# ----------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ----------------------------------------------------------
# IDE & Code Editors
# ----------------------------------------------------------
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# VS Code (preserve shared workspace settings)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ----------------------------------------------------------
# Temporary Files
# ----------------------------------------------------------
*.tmp
*.temp
tmp/
temp/
